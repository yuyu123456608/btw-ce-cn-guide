# 仓库只存「源 + 校验器」，构建产物不进库。
# 部署方式：GitHub Actions 里 build → verify（32 条全过）→ 上传 docs/ 作为 Pages artifact → 部署 → smoke。
# 这样一条数据的改动只产生一行 diff，不会再多出 143 个构建副本。

# —— 构建产物 ——
/docs/

# —— 制作现场：反编译输出、贴图池、探针、备份、中间数据 ——
/_*
/tools/*
!/tools/verify.js
!/tools/build-dist.js
!/tools/texpool-index.js
!/tools/texpool-index.json
!/tools/name-table.json
!/tools/field-aliases.json
!/tools/deprecated-names.json
!/tools/subtype-map.json
!/tools/font-charset.txt
!/tools/font-subset.py
!/tools/smoke.js

# 备份与探针截图（本地随手产物）
_items_before_*.js

# 根目录的制作现场（证据文本、解析产物、字体下载包）：只留 README.md 作为仓库门面
/*.txt
/*.json
/*.md
!/README.md
/fontwork/
